            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Nowak\",\n  \"totalprice\": 450,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2030-06-01\",\n    \"checkout\": \"2030-06-04\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
